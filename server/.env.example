# Copy this file to .env and fill in real values. Never commit .env.

# Stripe secret key (starts with sk_test_... or sk_live_...)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Stripe webhook signing secret (starts with whsec_...)
# Get this from `stripe listen --print-secret` in dev, or from the
# webhook endpoint you create in the Stripe Dashboard in production.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Where the frontend is hosted (used to build Stripe success/cancel URLs
# and for CORS). No trailing slash.
CLIENT_URL=http://localhost:5173

# Port the API server listens on
PORT=4000
